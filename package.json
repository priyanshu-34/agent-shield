{
  "name": "@priyans34/agent-shield",
  "version": "0.1.1",
  "description": "Stops AI agents from being tricked by hidden instructions in web pages, emails and files.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "prompt-injection",
    "security",
    "guardrails",
    "langchain",
    "langgraph",
    "mastra",
    "mcp"
  ],
  "author": "Priyanshu Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyanshu-34/agent-shield.git"
  },
  "homepage": "https://github.com/priyanshu-34/agent-shield#readme",
  "bugs": {
    "url": "https://github.com/priyanshu-34/agent-shield/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./langchain": {
      "import": {
        "types": "./dist/langchain.d.ts",
        "default": "./dist/langchain.js"
      },
      "require": {
        "types": "./dist/langchain.d.cts",
        "default": "./dist/langchain.cjs"
      }
    },
    "./langgraph": {
      "import": {
        "types": "./dist/langgraph.d.ts",
        "default": "./dist/langgraph.js"
      },
      "require": {
        "types": "./dist/langgraph.d.cts",
        "default": "./dist/langgraph.cjs"
      }
    },
    "./classifier": {
      "import": {
        "types": "./dist/classifier.d.ts",
        "default": "./dist/classifier.js"
      },
      "require": {
        "types": "./dist/classifier.d.cts",
        "default": "./dist/classifier.cjs"
      }
    },
    "./mastra": {
      "import": {
        "types": "./dist/mastra.d.ts",
        "default": "./dist/mastra.js"
      },
      "require": {
        "types": "./dist/mastra.d.cts",
        "default": "./dist/mastra.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/langchain.ts src/langgraph.ts src/classifier.ts src/mastra.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx examples/victim-demo.ts",
    "bench": "tsx bench/run.ts",
    "eval": "tsx bench/eval.ts",
    "record-demo": "tsx scripts/record-demo.ts && npx -y svg-term-cli@2.1.1 --in docs/demo.cast --out docs/demo.svg --window --width 132 --height 40"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.0.0",
    "@langchain/core": "^1.1.0",
    "@langchain/langgraph": "^1.0.0",
    "@mastra/core": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    }
  },
  "dependencies": {
    "node-html-parser": "^9.0.4",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.18",
    "@mastra/core": "^1.74.0",
    "@types/node": "^26.6.4",
    "@types/picomatch": "^4.0.3",
    "ai": "^7.0.127",
    "langchain": "^1.5.15",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}

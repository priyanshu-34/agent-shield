{
  "name": "agent-shield",
  "version": "0.0.1",
  "description": "Stops AI agents from being tricked by hidden instructions in web pages, emails and files.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./langchain": {
      "import": "./dist/langchain.js",
      "require": "./dist/langchain.cjs"
    },
    "./langgraph": {
      "import": "./dist/langgraph.js",
      "require": "./dist/langgraph.cjs"
    },
    "./classifier": {
      "import": "./dist/classifier.js",
      "require": "./dist/classifier.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/langchain.ts src/langgraph.ts src/classifier.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx examples/victim-demo.ts",
    "bench": "tsx bench/run.ts",
    "eval": "tsx bench/eval.ts"
  },
  "peerDependencies": {
    "@langchain/core": "^1.1.0",
    "@langchain/langgraph": "^1.0.0",
    "@huggingface/transformers": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "dependencies": {
    "node-html-parser": "^9.0.4",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.18",
    "@types/node": "^26.6.4",
    "@types/picomatch": "^4.0.3",
    "langchain": "^1.5.15",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}

[10.54,"o","\u001b[1;36m=== 3. With agent-shield: visible attack gets through Check In, Check Out stops it ===\u001b[0m\r\n"]
[11.44,"o","\u001b[33m[agent-shield] check-in tool:fetch_page: flagged ignore-previous; flagged note-to-ai\u001b[0m\r\n"]
[11.69,"o","\u001b[31m[agent-shield] block read_file: path \"notes/secrets.txt\" is a protected path\u001b[0m\r\n"]
[11.94,"o","\u001b[31m[agent-shield] block send_email: to \"attacker@evil.example\" is not in the allow list\u001b[0m\r\n"]
